{
  "name": "opcwise-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:all": "node scripts/dev.mjs",
    "dev:server": "node server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "build": "vite build --configLoader runner && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:short-film": "node --test tests/short-film-upload.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "better-sqlite3": "^13.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "pm2": "^7.0.3"
  }
}
